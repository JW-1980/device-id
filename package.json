        "ml:variants": "node tools/ml/variants.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "jsdom": "^30.1.1",
        "playwright": "1.63.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    }
}
